From 0c90b51da54072e15bcde753f46fee50a7735f73 Mon Sep 17 00:00:00 2001
From: Andrew Chadick <andrew@localhost>
Date: Mon, 12 Oct 2026 22:21:13 +0000
Subject: [PATCH 5/7] OpenCL on Mesa rusticl: self-contained sin/cos/tan, retry
 build without strict div/sqrt

---
 src/osv/render/opencl/OpenClRenderer.cpp | 17 +++++++++
 src/osv/render/opencl/preamble.cl        | 46 ++++++++++++++++++++++--
 2 files changed, 60 insertions(+), 3 deletions(-)

diff --git a/src/osv/render/opencl/OpenClRenderer.cpp b/src/osv/render/opencl/OpenClRenderer.cpp
index 87a59cc..9df9255 100644
--- a/src/osv/render/opencl/OpenClRenderer.cpp
+++ b/src/osv/render/opencl/OpenClRenderer.cpp
@@ -195,6 +195,23 @@ struct OpenClRenderer::Impl {
         // no fused contraction (matches /fp:precise and -fmad=false).
         const char* options = "-cl-std=CL1.2 -cl-fp32-correctly-rounded-divide-sqrt -cl-single-precision-constant";
         err = clBuildProgram(program, 1, &entry.device, options, nullptr, nullptr);
+        if (err != CL_SUCCESS) {
+            // Mesa rusticl with an unpatched upstream libclc (Fedora 44) fails to
+            // link the correctly-rounded divide/sqrt builtins ("nir_shader not
+            // fully linked").  Retry with the default-precision builtins; the
+            // selfcheck GPU-parity test reports whether the result still matches
+            // the CPU renderer.
+            clReleaseProgram(program);
+            program = clCreateProgramWithSource(context, 4, sources, lengths, &err);
+            if (err != CL_SUCCESS || !program) {
+                return failStatus(ErrorCode::Gpu, clMessage("clCreateProgramWithSource", err));
+            }
+            options = "-cl-std=CL1.2 -cl-single-precision-constant";
+            err = clBuildProgram(program, 1, &entry.device, options, nullptr, nullptr);
+            if (err == CL_SUCCESS) {
+                log::warn("OpenCL: strict divide/sqrt unavailable on this driver; built with default precision");
+            }
+        }
         // Always capture the log; warnings are useful even on success.
         size_t logSize = 0;
         clGetProgramBuildInfo(program, entry.device, CL_PROGRAM_BUILD_LOG, 0, nullptr, &logSize);
diff --git a/src/osv/render/opencl/preamble.cl b/src/osv/render/opencl/preamble.cl
index dd2ad30..808512e 100644
--- a/src/osv/render/opencl/preamble.cl
+++ b/src/osv/render/opencl/preamble.cl
@@ -12,9 +12,49 @@
 #define OSV_GLOBAL __global
 
 #define sqrtf(x) sqrt((float)(x))
-#define sinf(x) sin((float)(x))
-#define cosf(x) cos((float)(x))
-#define tanf(x) tan((float)(x))
+/* sin/cos/tan are implemented here rather than taken from the driver's
+ * libclc: upstream libclc as shipped by Fedora 44 (Mesa rusticl, unpatched)
+ * leaves its trig range-reduction helpers unlinked ("nir_shader not fully
+ * linked"), which makes the whole program fail to build.  Cody-Waite
+ * reduction by pi/2 in three float parts + Cephes minimax polynomials on
+ * [-pi/4, pi/4]; max error ~1.5e-7 for |x| < 1e4 rad, far beyond the angles
+ * the kernels use. */
+inline float osv_poly_sin(float z) {
+    float zz = z * z;
+    return z + z * zz * (-1.6666654611e-1f + zz * (8.3321608736e-3f + zz * -1.9515295891e-4f));
+}
+inline float osv_poly_cos(float z) {
+    float zz = z * z;
+    return 1.0f - 0.5f * zz +
+           zz * zz * (4.166664568298827e-2f + zz * (-1.388731625493765e-3f + zz * 2.443315711809948e-5f));
+}
+inline float osv_reduce_pio2(float x, int* quadrant) {
+    float q = floor(x * 0.636619772367581343f + 0.5f);
+    *quadrant = (int)q;
+    return ((x - q * 1.5703125f) - q * 4.837512969970703125e-4f) - q * 7.549789948768648e-8f;
+}
+inline float osv_sinf(float x) {
+    int q; float r = osv_reduce_pio2(x, &q);
+    switch (q & 3) {
+        case 0: return osv_poly_sin(r);
+        case 1: return osv_poly_cos(r);
+        case 2: return -osv_poly_sin(r);
+        default: return -osv_poly_cos(r);
+    }
+}
+inline float osv_cosf(float x) {
+    int q; float r = osv_reduce_pio2(x, &q);
+    switch (q & 3) {
+        case 0: return osv_poly_cos(r);
+        case 1: return -osv_poly_sin(r);
+        case 2: return -osv_poly_cos(r);
+        default: return osv_poly_sin(r);
+    }
+}
+inline float osv_tanf(float x) { return osv_sinf(x) / osv_cosf(x); }
+#define sinf(x) osv_sinf((float)(x))
+#define cosf(x) osv_cosf((float)(x))
+#define tanf(x) osv_tanf((float)(x))
 #define asinf(x) asin((float)(x))
 #define acosf(x) acos((float)(x))
 #define atanf(x) atan((float)(x))
