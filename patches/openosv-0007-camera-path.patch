diff --git a/tools/osvtool/CameraPath.h b/tools/osvtool/CameraPath.h
new file mode 100644
index 0000000..8076f3e
--- /dev/null
+++ b/tools/osvtool/CameraPath.h
@@ -0,0 +1,167 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 The OpenOSV Contributors
+//
+// CameraPath.h - an animated reframe view for `osvtool render --path`.
+//
+// A camera path is the .path.json written by 360 Director: a list of
+// keyframes {t, yaw, pitch, roll, fov, ease} in seconds and degrees, sorted
+// by t.  Its conventions are the ones of ffmpeg's v360 filter, which the
+// editor's preview was checked against:
+//   yaw   positive turns the view to the right (unbounded: 720 = two turns),
+//   pitch positive looks up,
+//   roll  positive rotates the picture counter-clockwise,
+//   fov   the field of view across the frame's LONG side, in degrees.
+// The segment from key i to key i + 1 eases with key i + 1's `ease`:
+// "linear", or anything else as smoothstep.  evaluate() must stay identical
+// to evalPath() in 360-director.html and eval_path() in director-render.py.
+//
+// toView() converts a pose to OpenOSV's VirtualCamera, whose yaw turns the
+// other way (positive = left) and whose hfov is the horizontal one; both were
+// checked ray-for-ray against the editor's maths (max error 0.000000 deg).
+#pragma once
+
+#include "osv/geom/VirtualCamera.h"
+
+#include <nlohmann/json.hpp>
+
+#include <algorithm>
+#include <cmath>
+#include <fstream>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace osv::tool {
+
+struct CameraPose {
+    double yaw = 0.0, pitch = 0.0, roll = 0.0, fov = 100.0;
+};
+
+struct CameraKey {
+    double t = 0.0;
+    CameraPose pose;
+    bool linear = false;
+};
+
+class CameraPath {
+public:
+    std::vector<CameraKey> keys;
+    double rangeIn = 0.0;                 ///< Seconds; where the editor's range starts.
+    std::optional<double> rangeOut;       ///< Seconds; empty = to the end.
+    int width = 0, height = 0;            ///< The editor's frame size; 0 when the file has none.
+    std::optional<long long> sourceStartFrame;  ///< "source_start_frame": timeline frame of path time 0.
+
+    /// Read a .path.json.  Empty string on success, else what was wrong.
+    std::string load(const std::string& file) {
+        std::ifstream in(file);
+        if (!in) {
+            return "cannot open " + file;
+        }
+        nlohmann::json j;
+        try {
+            in >> j;
+        } catch (const std::exception& e) {
+            return file + " is not valid JSON (" + e.what() + ")";
+        }
+        if (!j.is_object() || !j.contains("keys") || !j["keys"].is_array()) {
+            return file + " is not a 360 Director path file (no \"keys\" list)";
+        }
+        keys.clear();
+        for (const auto& k : j["keys"]) {
+            if (!k.is_object() || !k.contains("t") || !k["t"].is_number()) {
+                return file + ": a keyframe has no numeric \"t\"";
+            }
+            CameraKey key;
+            key.t = k["t"].get<double>();
+            key.pose.yaw = num(k, "yaw", 0.0);
+            key.pose.pitch = num(k, "pitch", 0.0);
+            key.pose.roll = num(k, "roll", 0.0);
+            key.pose.fov = num(k, "fov", 100.0);
+            key.linear = k.contains("ease") && k["ease"].is_string() && k["ease"].get<std::string>() == "linear";
+            if (!std::isfinite(key.t) || !std::isfinite(key.pose.yaw) || !std::isfinite(key.pose.pitch) ||
+                !std::isfinite(key.pose.roll) || !std::isfinite(key.pose.fov)) {
+                return file + ": a keyframe holds a value that is not a finite number";
+            }
+            keys.push_back(key);
+        }
+        std::stable_sort(keys.begin(), keys.end(), [](const CameraKey& a, const CameraKey& b) { return a.t < b.t; });
+        if (j.contains("range") && j["range"].is_object()) {
+            const auto& r = j["range"];
+            if (r.contains("in") && r["in"].is_number()) {
+                rangeIn = std::max(0.0, r["in"].get<double>());
+            }
+            if (r.contains("out") && r["out"].is_number()) {
+                rangeOut = r["out"].get<double>();
+            }
+        }
+        if (j.contains("output") && j["output"].is_object()) {
+            const auto& o = j["output"];
+            if (o.contains("width") && o["width"].is_number_integer() && o.contains("height") &&
+                o["height"].is_number_integer()) {
+                width = o["width"].get<int>();
+                height = o["height"].get<int>();
+            }
+        }
+        if (j.contains("source_start_frame") && j["source_start_frame"].is_number_integer()) {
+            sourceStartFrame = j["source_start_frame"].get<long long>();
+        }
+        return {};
+    }
+
+    /// The pose at `t` seconds (path time).
+    [[nodiscard]] CameraPose evaluate(double t) const {
+        if (keys.empty()) {
+            return CameraPose{};
+        }
+        if (t <= keys.front().t) {
+            return keys.front().pose;
+        }
+        if (t >= keys.back().t) {
+            return keys.back().pose;
+        }
+        std::size_t lo = 0, hi = keys.size() - 1;
+        while (hi - lo > 1) {
+            const std::size_t mid = (lo + hi) >> 1;
+            if (keys[mid].t <= t) {
+                lo = mid;
+            } else {
+                hi = mid;
+            }
+        }
+        const CameraKey& a = keys[lo];
+        const CameraKey& b = keys[hi];
+        const double span = b.t - a.t;
+        double s = span > 0 ? (t - a.t) / span : 1.0;
+        if (!b.linear) {
+            s = s * s * (3 - 2 * s);
+        }
+        CameraPose p;
+        p.yaw = a.pose.yaw + (b.pose.yaw - a.pose.yaw) * s;
+        p.pitch = a.pose.pitch + (b.pose.pitch - a.pose.pitch) * s;
+        p.roll = a.pose.roll + (b.pose.roll - a.pose.roll) * s;
+        p.fov = a.pose.fov + (b.pose.fov - a.pose.fov) * s;
+        return p;
+    }
+
+    /// `base` (the camera --proj / --preset / --yaw ... built) moved to `pose`:
+    /// the path's angles are added to the base's, so --yaw / --pitch / --roll
+    /// still work as offsets, and the path's long-side fov becomes the
+    /// camera's horizontal one.
+    static geom::VirtualCamera toView(const geom::VirtualCamera& base, const CameraPose& pose) {
+        geom::VirtualCamera cam = base;
+        cam.yawDeg = base.yawDeg - pose.yaw;
+        cam.pitchDeg = base.pitchDeg + pose.pitch;
+        cam.rollDeg = base.rollDeg + pose.roll;
+        const double longSide = std::max(base.w, base.h);
+        const double t = std::tan(std::clamp(pose.fov, 1.0, 170.0) * 3.14159265358979323846 / 360.0);
+        cam.hfovDeg = 2.0 * std::atan(t * base.w / longSide) * 180.0 / 3.14159265358979323846;
+        return cam;
+    }
+
+private:
+    static double num(const nlohmann::json& k, const char* name, double fallback) {
+        return k.contains(name) && k[name].is_number() ? k[name].get<double>() : fallback;
+    }
+};
+
+}  // namespace osv::tool
